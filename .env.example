# ==================== SERVIDOR ====================
NODE_ENV=development
PORT=3000

# ==================== SEGURANÇA ====================
# 🔑 Gere com:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=COLE_AQUI_64_BYTES_EM_HEX
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 🔐 Chave para criptografia de backups (32 bytes = 64 chars hex)
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=COLE_AQUI_32_BYTES_EM_HEX

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_ATTEMPTS=5

# ==================== BCRYPT ====================
BCRYPT_ROUNDS=12

# ==================== ADMIN PADRÃO ====================
ADMIN_EMAIL=admin@estoque.com
ADMIN_PASSWORD=trocar-em-producao
ADMIN_NOME=Administrador

# ==================== SUPER-ADMIN (desenvolvedor) ====================
SUPER_ADMIN_EMAIL=dev@estoque.com
SUPER_ADMIN_PASSWORD=trocar-em-producao
SUPER_ADMIN_NOME=Desenvolvedor